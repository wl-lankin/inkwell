{
  "name": "inkwell",
  "productName": "Inkwell",
  "version": "1.3.0",
  "description": "A calm, fast Markdown reader and writer.",
  "author": {
    "name": "Wolfgang Linz",
    "url": "https://wolfgang-linz.de"
  },
  "homepage": "https://github.com/wl-lankin/inkwell",
  "repository": {
    "type": "git",
    "url": "https://github.com/wl-lankin/inkwell.git"
  },
  "bugs": "https://github.com/wl-lankin/inkwell/issues",
  "keywords": [
    "markdown",
    "editor",
    "reader",
    "electron",
    "windows",
    "macos",
    "desktop"
  ],
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/build-icon.js",
    "dist": "npm run icon && electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --config electron-builder.config.js --mac --universal --publish never",
    "vendor": "node scripts/vendor.mjs",
    "welcome": "node scripts/welcome.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "gemoji": "^8.1.0",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "build": {
    "appId": "io.inkwell.app",
    "productName": "Inkwell",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "welcome.js",
      "theme-init.js",
      "build/icon.png",
      "icon.svg",
      "vendor/**",
      "electron/**",
      "node_modules/@fontsource-variable/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Inkwell-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inkwell",
      "runAfterFinish": true
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn"
        ],
        "name": "Inkwell.Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "icon": "build/file-icon",
        "rank": "Default"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "Inkwell-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Inkwell ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wl-lankin",
        "repo": "inkwell",
        "releaseType": "release"
      }
    ]
  }
}
